# ========================================================================
# THE SUGAR STORY — MONOREPO ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ========================================================================

# DATABASE & CACHING
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/sugarstory_db"
REDIS_URL="redis://localhost:6379"

# MEDUSA BACKEND CORE CONFIG
PORT=9000
MEDUSA_BACKEND_URL="http://localhost:9000"
JWT_SECRET="super-secret-jwt-key"
COOKIE_SECRET="super-secret-cookie-key"

# FRONTEND STOREFRONT CORE CONFIG
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="pk_sugarstory_key"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"

# CMS — SANITY STUDIO
NEXT_PUBLIC_SANITY_PROJECT_ID="sugarstory_proj_id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_READ_TOKEN="sanity_read_token_live"

# PAYMENTS — RAZORPAY (INDIA)
RAZORPAY_KEY_ID="rzp_test_sugarstory123"
RAZORPAY_KEY_SECRET="rzp_secret_key_secret_code"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_verification"

# SHIPPING & LOGISTICS (INDIA)
SHIPROCKET_EMAIL="logistics@thesugarstory.com"
SHIPROCKET_PASSWORD="shiprocket_secure_password"
PORTER_API_KEY="porter_express_delivery_key"

# CUSTOMER COMMUNICATIONS & SMS
MSG91_AUTH_KEY="msg91_auth_token_for_otp"
INTERAKT_API_KEY="interakt_whatsapp_business_api_key"
KLAVIYO_PUBLIC_KEY="klaviyo_public_key"
KLAVIYO_PRIVATE_KEY="klaviyo_private_key"

# ANALYTICS & ATTRIBUTION
META_PIXEL_ID="meta_pixel_id_for_storefront"
META_CAPI_ACCESS_TOKEN="meta_capi_server_access_token"
GA4_MEASUREMENT_ID="ga_measurement_id_tracking"
MIXPANEL_TOKEN="mixpanel_token_dashboard"

# CLOUD OBJECT STORAGE (S3/CLOUDFLARE R2)
S3_ENDPOINT="https://cloudflare-r2-endpoint-sugarstory"
S3_ACCESS_KEY="r2_access_key"
S3_SECRET="r2_secret_key"
S3_BUCKET="sugarstory-assets"

# NEXT-AUTH / SECURITY
NEXTAUTH_SECRET="next_auth_internal_secret"
NEXTAUTH_URL="http://localhost:3000"

# MONITORING & GOOGLE MAPS
SENTRY_DSN="sentry_error_logger_dsn"
GOOGLE_MAPS_API_KEY="google_maps_places_autocomplete_key"
