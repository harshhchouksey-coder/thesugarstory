# ========================================================================
# THE SUGAR STORY — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ========================================================================

# MONGO DATABASE CONNECTIONS
# Format: mongodb://<username>:<password>@<host>:<port>/<dbname>?authSource=admin
MONGO_URI="mongodb://admin:adminpassword@localhost:27017/sugarstory_db?authSource=admin"

# PAYMENTS — RAZORPAY (INDIA)
RAZORPAY_KEY_ID="rzp_test_placeholder_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"

# SECURITY & ADMINISTRATION
# The password used to access Chef Shalini's Admin Portal (must not be empty)
ADMIN_PASSWORD="ChooseYourSecurePassword2026"
